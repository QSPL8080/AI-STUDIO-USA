# PostgreSQL / Supabase Database Connection
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-supabase-key

# Server Port
PORT=3000

# Hostinger SMTP Email Dispatch
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@quickuppaistudio.us
SMTP_PASS=your-hostinger-password
EMAIL_FROM=info@quickuppaistudio.us
LEAD_NOTIFICATION_EMAIL=qsaistudio@gmail.com

# Gmail SMTP Email Dispatch (qsaistudio@gmail.com)
GMAIL_USER=qsaistudio@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# PayPal Payment Gateway Integration
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=sandbox

